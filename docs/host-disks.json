rsonality, which has two channels; RIDE and AT-Bus 2008 have only channel 0.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"DRjWMDKTmv"}],"key":"iItXAzGlgQ"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"inlineCode","value":"device","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"sHQZY1PE3E"},{"type":"text","value":" is the host’s current enumeration name, exactly as ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"edxZtH7t9B"},{"type":"inlineCode","value":"--list-disks","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"MHNaqazweg"},{"type":"text","value":"\nprints it: ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"iDQebmoVnH"},{"type":"inlineCode","value":"sdb","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"LhdBknKxtB"},{"type":"text","value":" on Linux, ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"mJdpC8X84X"},{"type":"inlineCode","value":"disk4","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"nVt9ozJng3"},{"type":"text","value":" on macOS, or ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"aMmqnxKXN5"},{"type":"inlineCode","value":"PhysicalDrive1","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"E8HyQoAgyT"},{"type":"text","value":" on Windows.\nThose names can change when disks are attached in a different order. The\nlauncher therefore saves ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"JoxgabZHWI"},{"type":"inlineCode","value":"fingerprint","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"mzpsBb9DjO"},{"type":"text","value":", an opaque identity made from the\ndisk’s reported serial/model and geometry. On the next run the fingerprint is\nauthoritative: Copperline follows the same disk to a changed name only when\nexactly one attached disk matches it, and refuses a missing or ambiguous\nmatch rather than guessing. Keep the value the launcher wrote; do not invent\nor copy one between disks.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"tfVkhnoYRd"}],"key":"qcBglzTUpO"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Older and hand-written entries may omit ","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"If2SUBSTUp"},{"type":"inlineCode","value":"fingerprint","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"Vj5hNN8BKc"},{"type":"text","value":"; they use an exact\n","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"qaH5Ub2rtn"},{"type":"inlineCode","value":"device","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"KasjJV2hwJ"},{"type":"text","value":" lookup and cannot follow a renamed disk. To add one, select and mount\nthe disk afresh in the launcher, then save or launch; merely opening and\nsaving the old entry deliberately preserves the missing fingerprint. A disk\nthat cannot be resolved leaves that drive slot empty and the machine starts\nanyway, as a real Amiga does with an absent drive.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"PdvFYDfrDI"}],"key":"A5oo2sQenD"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Persisted permission to write is deliberately narrower than fingerprint\nmatching. Removable media is always treated as weak, even if its USB bridge\nreports a serial: that value often identifies the reader rather than the card\ninside it. The same is true of any fixed disk without a credible serial or\nWWN. A fingerprint can still resolve either kind for read-only use, but select\nand mount the physical disk afresh in the launcher before every writable\nsession. Only a fixed, non-removable disk with a credible serial/WWN may reopen\nwritable from persisted configuration.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"chCoow37Iu"}],"key":"o9knM51dKF"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"Omitting ","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"VVgxZSKm3V"},{"type":"inlineCode","value":"read_only","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"RKM8B5gHh5"},{"type":"text","value":" is safe: it now means read-only. This intentionally makes\nolder configs that omitted the key read-only too; set ","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"fGDMAuwM9F"},{"type":"inlineCode","value":"read_only = false","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"fo9Y2SLTg1"},{"type":"text","value":"\nonly after checking the selected disk. The command-line flags describe a\nchoice made for this run, so ","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"XvWb7zfMxV"},{"type":"inlineCode","value":"--host-disk","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"WFeg1kuhQR"},{"type":"text","value":" is explicitly read-write and\n","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"J5cZ1pLnAz"},{"type":"inlineCode","value":"--host-disk-read-only","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"yJ7nJSuz28"},{"type":"text","value":" is protected.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"YWdnrAZJz1"}],"key":"c9gLzAmLOy"},{"type":"heading","depth":2,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Read-only first","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"TgBIo2PCUi"}],"identifier":"read-only-first","label":"Read-only first","html_id":"read-only-first","implicit":true,"key":"t3jc0FXx2b"},{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Attach a disk read-only the first time. It costs one boot and tells you more\nthan anything else:","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"rd4EWNZ7gM"}],"key":"BZB5TgtWWJ"},{"type":"code","lang":"sh","value":"copperline --model A1200 --fast 8M KICK31.ROM --host-disk-read-only sdb","position":{"start":{"line":115,"column":1},"end":{"line":117,"column":1}},"key":"eAO1v33g0E"},{"type":"paragraph","position":{"start":{"line":119,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"An Amiga filesystem writes when it mounts -- PFS marks the volume in use --\nso a ","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"FkQrs6HI2D"},{"type":"emphasis","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"correct","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"BaFVzPeJa3"}],"key":"BNZaheAPhS"},{"type":"text","value":" read-only attach boots far enough to raise the guest’s own\nwrite error, and the log names the same block:","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"hV6r60PeYh"}],"key":"YJGKZZ15oF"},{"type":"code","lang":"text","value":"blockdev: sdb is attached read-only, so the guest's write to sector 1026146\n          was refused; tick R/W (or set `read_only = false`) to let it write","position":{"start":{"line":123,"column":1},"end":{"line":126,"column":1}},"key":"weYxnNU6S0"},{"type":"paragraph","position":{"start":{"line":128,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"That proves the read path end to end. Attach it read-write and it should\nreach Workbench with no requester at all.","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"TzMPy7H476"}],"key":"TWoQrW85q6"},{"type":"heading","depth":2,"position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"While the machine has it","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"oLJSgp9snF"}],"identifier":"while-the-machine-has-it","label":"While the machine has it","html_id":"while-the-machine-has-it","implicit":true,"key":"RIOoMP6an4"},{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"The disk is taken from the host completely. Volumes mounted from it are\nunmounted first -- the host writing its own metadata under a guest that\ncannot account for it changing is a hazard either way -- and the medium stays\nthe machine’s until you give it back. If something else still has a file open\non the disk, the attach fails and says so rather than taking it out from\nunderneath.","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"cfgNa8Nn6k"}],"key":"yiy39RZGyt"},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"It is taken once, at ","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"VoPG2DjIze"},{"type":"strong","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Mount","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"KGiBzx5EBs"}],"key":"oMqC15urT8"},{"type":"text","value":" (or when a configuration-driven run first\nstarts), and stays taken for the 