{"version":3,"kind":"Article","sha256":"810d9a58282a6738671657f981bc948a0031726fd104d276dadaf2b3d75a0dff","slug":"jit-performance","location":"/internals/jit-performance.md","dependencies":[],"frontmatter":{"title":"Measuring JIT performance","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Andrew Hutchings","given":"Andrew","family":"Hutchings"},"name":"Andrew Hutchings","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/CopperlineHQ/Copperline","keywords":["amiga","emulator","ocs","ecs","rust"],"numbering":{"title":{"offset":1}},"source_url":"https://github.com/CopperlineHQ/Copperline/blob/main/docs/internals/jit-performance.md","edit_url":"https://github.com/CopperlineHQ/Copperline/edit/main/docs/internals/jit-performance.md","exports":[{"format":"md","filename":"jit-performance.md","url":"/docs/build/jit-performance-2f72fb422ba0353697a8b669d34e932f.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"JIT performance depends on the guest workload, memory placement, CPU model and\nhost. Measure real applications and sustained audio/video alongside synthetic\nCPU loops. Keep fixed-clock and paced-fastest results separate: fixed mode is\ndeterministic, while fastest mode changes guest throughput with host load.\nSee ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sdSbAKo7Yo"},{"type":"crossReference","url":"/cpu","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"CPU execution","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PrT3wRFLuy"}],"urlSource":"cpu.md#jit-fastest-speed","dataUrl":"/cpu.json","identifier":"jit-fastest-speed","label":"jit-fastest-speed","remote":true,"protocol":"file","kind":"heading","template":"{name}","resolved":true,"html_id":"jit-fastest-speed