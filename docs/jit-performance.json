e host. Preserve guest inputs and timestamps. Use several trials\nand report medians together with the individual measurements. A single fast\nsample, synthetic MIPS result or different host does not establish an\napplication improvement or parity with another emulator.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"DAvU0vq7o2"}],"key":"q1iHTiuuxi"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"fMk6XGtdOF"},{"type":"inlineCode","value":"--factory","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"blLOERyV94"},{"type":"text","value":" or an explicit configuration so a saved launcher default cannot\nchange the machine. Pin the RTC with ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"vi7EpbbX9x"},{"type":"inlineCode","value":"--rtc-time","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Qvt33PI1Cd"},{"type":"text","value":" and ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"mWlsijgfLT"},{"type":"inlineCode","value":"--rtc-frozen","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"E6St6anEjb"},{"type":"text","value":" when guest\nsoftware reads it. Keep the ROM, media, memory layout and cache settings equal\nbetween revisions. ROMs, disk images and third-party executables remain local\nassets.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"o1uElLdqF5"}],"key":"sb9GWQ2rxD"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Application throughput","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"udcJKn1bdG"}],"identifier":"application-throughput","label":"Application throughput","html_id":"application-throughput","implicit":true,"key":"xb3T2Hp2a4"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"An archive compressor exercises CPU-local loops, OS calls and storage. For an\nLhA workload, use A1200, 68040 at 25 MHz, 8 MiB fast RAM, Kickstart 3.1, JIT,\nno audio, and a mounted empty read-only ENV volume. The ","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"E6T9ULPWEa"},{"type":"link","url":"/run","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"direct execution\nguide","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"Mf0INRm9rM"}],"urlSource":"../guide/run.md","dataUrl":"/run.json","internal":true,"protocol":"file","key":"Vfo6ydgjsn"},{"type":"text","value":" describes executable and volume setup. Use the same\n","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"ccDTiIe5nD"},{"type":"inlineCode","value":"lha_68040","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"UyOCp55zcw"},{"type":"text","value":" binary for every run.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"zKx2S3JNCm"}],"key":"Qd903p23nl"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Generate a deterministic input file:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"PNiyeFA2yD"}],"key":"CiPczc5Lc8"},{"type":"code","lang":"python","value":"from pathlib import Path\n\ntext = ''.join(\n    f'{i:08x} Copperline Motorola 68040 chipset scheduling and direct memory throughput {i*i:016x}\\n'\n    for i in range(45_000)\n)\nPath('input.txt').write_bytes(text.encode('ascii'))","position":{"start":{"line":39,"column":1},"end":{"line":47,"column":1}},"key":"bjcZ1ZJXLf"},{"type":"paragraph","position":{"start":{"line":49,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"The input contains 4,500,000 bytes and has SHA-256\n","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"yTeZxTJMI2"},{"type":"inlineCode","value":"44521e57d459ef06a6714c2ec4bc19bc8b82cb209c1d7d83eda7b13cdc6d99b2","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"PzK0lNFAoW"},{"type":"text","value":".\nPreserve its modification time and use a fresh output directory for each trial.\nLaunch with ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"kGcQgwaFGT"},{"type":"inlineCode","value":"--run lha_68040 --run-args \"-q a archive.lha input.txt\" --exit-on-return","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"wuluXONr1n"},{"type":"text","value":", a frozen RTC at ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"gxWnEGnndb"},{"type":"inlineCode","value":"2005-03-18 01:58:29","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"aUp39M8Zhz"},{"type":"text","value":", and the chosen\n","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"B0uiqzesSq"},{"type":"inlineCode","value":"--cpu-speed fixed","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"ZPpENkxBhf"},{"type":"text","value":" or ","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"biVsQSXdVZ"},{"type":"inlineCode","value":"--cpu-speed fastest","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"iKPXnZTyXJ"},{"type":"text","value":" setting.","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"gVMJe0Y69P"}],"key":"j2uDUAK4eV"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Set ","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"XnSPmuJr8Y"},{"type":"inlineCode","value":"COPPERLINE_HEADLESS_PACED=1","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"OIeWI2JLdp"},{"type":"text","value":" to exercise the same pacing policy as an\ninteractive session. Record host elapsed time and guest elapsed time: wall time\nincludes boot and compression, and guest time reveals a machine falling behind\nreal time. Require exit status zero and extract every output archive to verify\nthat its contents hash to the original input. Throughput without correct output\nis not an accepted result.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"sIpAGvMkOi"}],"key":"zCQqz7Ilk3"},{"type":"heading","depth":2,"position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Audio, DMA and rendering","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"zQzMkjzvPY"}],"identifier":"audio-dma-and-rendering","label":"Audio, DMA and rendering","html_id":"audio-dma-and-rendering","implicit":true,"key":"q9EpMOmzwS"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Use a sustained Paula/DMA/rendering workload as well as the CPU-heavy program.\nOne reproducible example is State of the Art with an A500-shaped machine, 68020\nat 14.18 MHz, 512 KiB chip RAM, 512 KiB slow RAM, 8 MiB fast RAM, Kickstart 1.3,\nJIT and the disk in DF0. Run with live ","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"GQQ3rOmsG5"},{"type":"inlineCode","value":"--audio","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"hp2U7mSnJv"},{"type":"text","value":" and capture frames at 30, 60 and\n90 guest seconds. Enable ","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"yC0IvhqFFd"},{"type":"inlineCode","value":"COPPERLINE_HEADLESS_PACED=1","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"sHLnPURYus"},{"type":"text","value":",\n","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"A1cAO68CBB"},{"type":"inlineCode","value":"COPPERLINE_REAL_PACING_PROFILE=1","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"mBwXO298OC"},{"type":"text","value":" and ","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"tD0n7iDVE2"},{"type":"inlineCode","value":"COPPERLINE_AUDIO_PROFILE=1","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"mRpvMtk8Uv"},{"type":"text","value":".","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"n92Bmw93YA"}],"key":"tYb3aCdDyb"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Report host time for the full guest interval, audio underruns during startup\nand steady playback, and screenshots showing that the guest kept progressing.\nCount only ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"z3iURZpmCl"},{"type":"inlineCode","value":"audio profile: queue_depth=","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"GoCquEt1cL"},{"type":"text","value":" records: their underrun counter records\nfailed reads, not every silent frame while the backend refills. Capture a WAV\nseparately when checking that the guest actually generated audio. A paced\nheadless audio run does not validate the window/GPU presentation path.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"bX7nciJaEp"}],"key":"i2tSz2xU0b"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Use golden-render tests and fresh-machine save/restore comparisons to check\ncorrectness independently of speed. Fastest-mode captures need not be\nbyte-identical because guest throughput is host-dependent.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"yBf4J0YHMK"}],"key":"M6fuOEvEm8"},{"type":"heading","depth":2,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"Synthetic loops and profiles","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"tPnGiY7V6z"}],"identifier":"synthetic-loops-and-profiles","label":"Synthetic loops and profiles","html_id":"synthetic-loops-and-profiles","implicit":true,"key":"jwkQG3lMhx"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"The diagnostic example separates paced throughput, local-memory placement,\nchipset cost and bare-core overhead:","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"zO0eed7wdV"}],"key":"v4kIso3TLM"},{"type":"code","lang":"sh","value":"cargo build --release --locked --no-default-features --features frontend,cpu-jit \\\n  --example jit_throughput\n./target/release/examples/jit_throughput 3 paced\n./target/release/examples/jit_throughput 3 mem","position":{"start":{"line":88,"column":1},"end":{"line":93,"column":1}},"key":"Gf4Tpzo8cF"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"Report instructions per host second for paced tests; instructions per guest\nsecond alone can hide failure to sustain real time. Warm the JIT before timing,\nand retain CPU/cache/memory placement details when comparing bare-core loops.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"VupL8X5w6W"}],"key":"GVN8v4GeS3"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Profile the same workload interval in both binaries. A saved state can skip\nboot and loading, but use a matching state for each machine configuration and\nrecord its provenance. Keep profiles separate from timed trials because sampling\nadds overhead. Attribute an improvement only after repeating the application\nand correctness checks; reducing setup work must preserve device deadlines,\ninterrupt recognition, cache coherence and fresh-machine restore behavior.","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"jk7aNXXcCy"}],"key":"KsXdJb495Q"}],"key":"hw4iKWnqvJ"}],"key":"u8bX2FwdIy"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"CPU integration","url":"/cpu","group":"Internals"},"next":{"title":"Peripherals and expansion","url":"/peripherals","group":"Internals"}}},"domain":"http://localhost:3000"}