{"version":3,"kind":"Article","sha256":"e32eb930f22e07cf8bc22289400bf750cc4d9c92c19aab4c9202c0032e449a5d","slug":"jit-performance","location":"/internals/jit-performance.md","dependencies":[],"frontmatter":{"title":"Measuring performance","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Andrew Hutchings","given":"Andrew","family":"Hutchings"},"name":"Andrew Hutchings","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/CopperlineHQ/Copperline","keywords":["amiga","emulator","ocs","ecs","aga","rust"],"numbering":{"title":{"offset":1}},"source_url":"https://github.com/CopperlineHQ/Copperline/blob/main/docs/internals/jit-performance.md","edit_url":"https://github.com/CopperlineHQ/Copperline/edit/main/docs/internals/jit-performance.md","exports":[{"format":"md","filename":"jit-performance.md","url":"/docs/_public/jit-performance-19e9045fb38272790471c0604187793f.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Performance depends on the guest workload, memory placement, CPU model,\nexecution mode and host. Measure real applications and sustained audio/video\nalongside synthetic CPU loops. Keep fixed-clock and paced-fastest results\nseparate: fixed mode is deterministic, while fastest mode changes guest\nthroughput with host load.\nSee ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lpFlHzhr7C"},{"type":"crossReference","url":"/cpu","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"CPU execution","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XQYwnjRsMT"}],"urlSource":"cpu.md#jit-fastest-speed","dataUrl":"/cpu.json","identifier":"jit-fastest-speed","label":"jit-fastest-speed","remote":true,"protocol":"file","kind":"heading","template":"{name}","resolved":true,"html_id":"jit-fastest-speed","key":"aeBIZXmVTP"},{"type":"text","value":" and\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iRNdXoUwNu"},{"type":"crossReference","url":"/timing","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"pacing","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WByYdgKZdo"}],"urlSource":"timing.md#jit-fastest-pacing","dataUrl":"/timing.json","identifier":"jit-fastest-pacing","label":"jit-fastest-pacing","remote":true,"protocol":"file","kind":"heading","template":"{name}","resolved":true,"html_id":"jit-fastest-pacing","key":"OafN1Szc5x"},{"type":"text","value":" for the scheduling model.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z7DW5Av61X"}],"key":"rhLdgrTk9j"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Establish a comparison","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"F09chdgFFP"}],"identifier":"establish-a-comparison","label":"Establish a comparison","html_id":"establish-a-comparison","implicit":true,"key":"WxTDIHhNJW"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Build both revisions with the same Rust toolchain, target, features and release\nprofile. Preserve each binary, its source revision, dependency revision and\nSHA-256 before starting. Record the host CPU, operating system, power mode and\nany enforced frequency limit; a CPU’s model string is not a frequency cap.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"igUmsAf2Dp"}],"key":"BPmuXBZ4Fz"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Alternate baseline and candidate runs, with no compiler or competing benchmark\nrunning on the host. Preserve guest inputs and timestamps. Use several trials\nand report medians together with the individual measurements. A single fast\nsample, synthetic MIPS result or different host does not establish an\napplication improvement or parity with another emulator.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"zy8Z1UAlZW"}],"key":"iQUPhaR4UW"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Use ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"W6qjPYaAFR"},{"type":"inlineCode","value":"--factory","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"DmG6pJrXnA"},{"type":"text","value":" or an explicit configuration so a saved launcher default cannot\nchange the machine. Pin the RTC with ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ji1nBto7qr"},{"type":"inlineCode","value":"--rtc-time","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"LAwENkXSrj"},{"type":"text","value":" and ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"eaDdgysLO2"},{"type":"inlineCode","value":"--rtc-frozen","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ZV1kYWrvIU"},{"type":"text","value":" when guest\nsoftware reads it. Keep the ROM, media, memory layout and cache settings equal\nbetween revisions. ROMs, disk images and third-party executables remain local\nassets.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"TK51VTtg3c"}],"key":"O0E7H7qfmg"},{"type":"heading","depth":2,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"CI AROS performance gate","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"EnljTeGFYO"}],"identifier":"ci-aros-performance-gate","label":"CI AROS performance gate","html_id":"ci-aros-performance-gate","implicit":true,"key":"rMGlWxG7tO"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"UERDY2hsRA"},{"type":"inlineCode","value":"Performance","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"NKadteSyZx"},{"type":"text","value":" workflow runs ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"bakpq3KVJc"},{"type":"inlineCode","value":"AROS performance gate","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"iaFJjqGR5E"},{"type":"text","value":" on every PR and on\npushes to ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"Zl9dappmEg"},{"type":"inlineCode","value":"main","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"ply5zEXX8j"},{"type":"text","value":" and ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"gvApfXjKFu"},{"type":"inlineCode","value":"v1","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"mbBuENFUIj"},{"type":"text","value":", with no path filter. It compares ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"zDQsST3QL9"},{"type":"inlineCode","value":"copperline-bench","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"prwk45k6Cy"},{"type":"text","value":"\nexecutables built using the same stable Rust toolchain, ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"S4Qfbf0P9o"},{"type":"inlineCode","value":"--release --locked --no-default-features --features bench-bin","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"HGSaBOdq7t"},{"type":"text","value":": once from the full commit SHA in\n","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"NUGphXCXtO"},{"type":"inlineCode","value":"tools/performance/baseline.json","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"hKA2XGqWQR"},{"type":"text","value":", and once from the candidate (the PR merge\ncommit on a PR). This pins a cumulative comparison point before Bus or\nworkspace refactoring. It does not move to each PR’s parent automatically.\nBoth branches share this one baseline, including any differences between\n","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"i4a9mzg2uV"},{"type":"inlineCode","value":"main","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"tChucal9g0"},{"type":"text","value":" and ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"Dgz8kAYelJ"},{"type":"inlineCode","value":"v1","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"cMDWGQdU1W"},{"type":"text","value":"; a forward merge does not select a different baseline.\nRequire ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"mbhQrehqMY"},{"type":"strong","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"AROS performance gate","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"hCJ2t8TeOy"}],"key":"RsKYP7L6cC"},{"type":"text","value":" in the protected branches’ rules to make\nthe check a mandatory merge gate; adding the workflow does not change those\nrepository settings.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"aw4suksuo8"}],"key":"AapjxoJEgW"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The baseline cache holds only the executable, keyed by its source SHA,\nthe complete ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"ISrMS0dY1J"},{"type":"inlineCode","value":"rustc -Vv","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"aVoOieeQe0"},{"type":"text","value":" output and workflow hash, runner OS/architecture\nand Ubuntu image family. Workflow changes invalidate the build recipe too.\nAn exact hit skips baseline compilation; a miss builds it with the same\ncommand. There are no fallback keys. Only pushes to ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"J3yRPkiF26"},{"type":"inlineCode","value":"main","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"iidybpG6aq"},{"type":"text","value":" or ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"CqhaWNoitc"},{"type":"inlineCode","value":"v1","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"JeFEFMMvrA"},{"type":"text","value":" save\nshared baseline caches; PRs restore them without saving merge-ref copies.\nThe candidate is always built. Cache key/hit records accompany the binary\nhash and source/toolchain provenance in the performance artifact.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"iRioUBHwTA"}],"key":"CahDAMA1IE"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"The tracked TOML files specify PAL A500 (68000, 512 KiB chip and slow RAM)\nand A1200 (68EC020, 2 MiB chip RAM) cold boots with empty drives. Both use\nfixed CPU clocks, interpreter execution, zeroed RAM and a frozen RTC. The\nsame explicitly named AROS ROM pair is used for both revisions, with its\nSHA-256 hashes pinned in the policy. Each machine runs for 30 emulated\nseconds both core-only and with CPU rendering, post-processing and\ndeinterlacing. This covers common CPU/bus/chipset/render paths without\nproprietary assets. It does not cover native JIT throughput, disk-heavy\napplications, live audio, GPU presentation or every expansion board.","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"z4wwuOVonJ"}],"key":"Kxj5IxLXwc"},{"type":"paragraph","position":{"start":{"line":64,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Both compilations finish before timing starts. Each of the four cases gets\none discarded warmup per binary, then five baseline/candidate pairs on the\nsame runner, reversing order every pair. The gate compares the median of\nthe paired wall-time-per-emulated-frame ratios and fails above a 10%\nslowdown. Improvements in one case cannot offset a regression in another.\nThe threshold allows some shared-host jitter; absolute milliseconds from\ndifferent hosts or workflow runs are not compared.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"fYWYxxUk4e"}],"key":"mbILWDgCXI"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Missing or malformed output, non-zero exit, a 120-second sample timeout,\nincomplete emulated time, or mismatched emulated frame counts/presented\ncounts/render checksums fails the case. A median absolute deviation above\n5% of the median paired ratio also fails, reporting unstable timing instead\nof claiming success. This measures noise in the value used for the verdict;\nhost drift shared by both sides of each pair cancels instead of failing a\ncomparison with identical ratios. No outlier is removed and no fast retry\nis selected. Each binary must still repeat the same workload across its\nown warmup and measured trials.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"qtDs7iXE1r"}],"key":"nxLkr5RfXK"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"The benchmark’s existing checksum is a coarse presentation check, not an\nimage comparison: keep the golden-render and functional suites required\nalongside this check. The benchmark’s frame-time sample count can exceed\nthe emulated frame count because a core step may stop at an internal\nboundary; throughput uses elapsed wall time and retired emulated frames.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"Uab9Q1K63n"}],"key":"rvEyleVtZw"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"The job summary lists each median, paired percentage change and result.\nWhen the two internally repeatable workloads differ, the case fails with\n","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"gFsocJNzFv"},{"type":"strong","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"workload changed, baseline refresh needed","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"NDds9KqmEx"}],"key":"Zz8S5kR4nH"},{"type":"text","value":". Its medians, paired ratios\nand noise measurement are retained in ","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"FWkZXgjbLI"},{"type":"inlineCode","value":"report.json","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"cP5p8a43ZG"},{"type":"text","value":", and the summary\nmarks the percentage change as informational. These numbers describe the\nchange but cannot establish equal-work performance parity.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"QzeACdqUfI"}],"key":"ncaBL9gstK"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"MgkZTodpJu"},{"type":"inlineCode","value":"aros-performance","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"Zt170PKSL5"},{"type":"text","value":" artifact retains raw warmup/trial logs, all paired\nmeasurements in ","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"kEQaOzi8j8"},{"type":"inlineCode","value":"report.json","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"jMRPXaWAgh"},{"type":"text","value":", configuration/ROM/binary hashes, source SHAs,\nlockfile hashes, toolchain and host details for 14 days, including failures.\nReview these before rerunning a noisy job. A stalled job is bounded to\n30 minutes. The Python gate tests explicitly exercise slower candidates,\nmissing output, timeouts, workload mismatches and unstable samples.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"nfH2CbtE7a"}],"key":"VuGo1Msi4Q"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"To reproduce locally, first build and preserve the baseline binary in a\nseparate checkout of the pinned revision, then build the candidate with\nthe same command, toolchain and target. Print the required baseline SHA\nwith ","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"Un903v5CXb"},{"type":"inlineCode","value":"python3 tools/check-performance.py --print-baseline","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"li0T7RTFvf"},{"type":"text","value":". With no builds\nor competing workloads running, invoke:","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"SCzUVXUYDN"}],"key":"meF0S4Xn8o"},{"type":"code","lang":"sh","value":"python3 tools/check-performance.py \\\n  --baseline-binary /path/to/baseline/target/release/copperline-bench \\\n  --candidate-binary target/release/copperline-bench","position":{"start":{"line":108,"column":1},"end":{"line":112,"column":1}},"key":"RGM1cgyRLB"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"Results go to ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"HNDqe42Nje"},{"type":"inlineCode","value":"target/performance-gate/","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"hH0r5TIQUB"},{"type":"text","value":" (","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"tzeEyBFrip"},{"type":"inlineCode","value":"--output","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"WOtM6Ay3GD"},{"type":"text","value":" selects another\ndirectory). The harness strips inherited ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"URUp7Ktc0l"},{"type":"inlineCode","value":"COPPERLINE_*","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"Rte5SWXTzQ"},{"type":"text","value":" settings, passes\nexplicit absolute config/ROM paths, and gives each process a fresh working\ndirectory, so local diagnostics, assets and saved launcher defaults cannot\nalter the workload. Run its asset-free supervision tests with:","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"obhMiJJqoE"}],"key":"z5n72xUn6W"},{"type":"code","lang":"sh","value":"python3 -m unittest discover -s tools/tests -p test_performance.py -v","position":{"start":{"line":120,"column":1},"end":{"line":122,"column":1}},"key":"gCnCAmLmI2"},{"type":"paragraph","position":{"start":{"line":124,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"text","value":"Update the baseline SHA, ROM hashes or workloads only in an explicit,\nreviewed change. Preserve the old and proposed baseline comparisons and\nexplain any intended emulation or workload changes. Do not refresh the\nbaseline merely to make a slowdown pass, or copy a developer machine’s\nabsolute timings into the policy. The 10% limit and 5% noise threshold\nshould be revisited with retained hosted-run evidence if runner variance\nchanges.","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"xNMCuzwL0w"}],"key":"GuwlwI0sMI"},{"type":"paragraph","position":{"start":{"line":132,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"For an intended timing or rendering correction that changes the workload\nsignature, keep the old baseline during review so the correction’s own\ncost remains visible. Attach its failed performance artifact and the\nfunctional/golden evidence explaining the intended signature change. If\nbranch rules require this check, a maintainer can record and approve an\noverride for that specific PR under the repository’s protection policy.\nAfter merging the correction, refresh the pin to its immutable merged\ncommit in a separate reviewed PR and rerun the gate. Preserve the original\ncomparison alongside the refresh. Pointing the fix’s own PR at itself\nwould hide the performance effect that required the refresh.","position":{"start":{"line":132,"column":1},"end":{"line":132,"column":1}},"key":"qyoii3w48e"}],"key":"f5wQBAslLv"},{"type":"heading","depth":2,"position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Application throughput","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"RcueRfP4PY"}],"identifier":"application-throughput","label":"Application throughput","html_id":"application-throughput","implicit":true,"key":"qV1DdAQLzk"},{"type":"paragraph","position":{"start":{"line":145,"column":1},"end":{"line":149,"column":1}},"children":[{"type":"text","value":"An archive compressor exercises CPU-local loops, OS calls and storage. For an\nLhA workload, use A1200, 68040 at 25 MHz, 8 MiB fast RAM, Kickstart 3.1, JIT,\nno audio, and a mounted empty read-only ENV volume. The ","position":{"start":{"line":145,"column":1},"end":{"line":145,"