 ","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"gZQbCtZ248"},{"type":"inlineCode","value":"save_states","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"Gd1UQe2QJw"},{"type":"text","value":" choice.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"Rw6LHFUGAt"}],"key":"MpGMcvrAe7"},{"type":"heading","depth":2,"position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"children":[{"type":"text","value":"Verifying a bundle","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"CWfAvHUYhk"}],"identifier":"verifying-a-bundle","label":"Verifying a bundle","html_id":"verifying-a-bundle","implicit":true,"key":"vXMxQ58r3V"},{"type":"paragraph","position":{"start":{"line":125,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"text","value":"The player keeps one hidden flag for exactly this: ","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"L8s4F7ATtb"},{"type":"inlineCode","value":"--screenshot-after SECS PATH","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"uQCcpAgTjQ"},{"type":"text","value":" runs the machine headless and unthrottled, writes the\nframebuffer at the emulated timestamp, and exits -- the same deterministic\nverification the main binary offers (","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"Yy6yXlk5qn"},{"type":"link","url":"/headless","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"Headless and scripted runs","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"Je2PyDbYr7"}],"urlSource":"headless.md","dataUrl":"/headless.json","internal":true,"protocol":"file","key":"ORbVZjer1q"},{"type":"text","value":"). A publisher’s CI\ncan boot the assembled bundle and compare the screenshot against a known\ngood frame:","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"D3CROASttJ"}],"key":"C9zta2Qkyi"},{"type":"code","lang":"sh","value":"\"Skyhawks.app/Contents/MacOS/skyhawks\" --screenshot-after 30 boot.png","position":{"start":{"line":132,"column":1},"end":{"line":134,"column":1}},"key":"akgmvwLDLw"},{"type":"paragraph","position":{"start":{"line":136,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"For everything richer -- scripted input, save states, the control\nprotocol -- test with the full Copperline against the same payload, and\nship with the player.","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"r6kO1wneUT"}],"key":"xCcQhwnDsA"},{"type":"heading","depth":2,"position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Licensing obligations, in short","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"fHHPmkAOdO"}],"identifier":"licensing-obligations-in-short","label":"Licensing obligations, in short","html_id":"licensing-obligations-in-short","implicit":true,"key":"qBTbTQbR6g"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"text","value":"The bundle ","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"Si8YTJRchG"},{"type":"inlineCode","value":"tools/publish","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"h8WBRL1alM"},{"type":"text","value":" assembles already contains what redistribution\nrequires: Copperline’s GPL-3.0-or-later text with a corresponding-source\nlink (a tagged-release URL suffices for unmodified builds), and the AROS\nROM pair’s APL 1.1 license and acknowledgements beside the ROM files. The\ngame payload itself stays the publisher’s own work under their own terms.\nA publisher who ","position":{"start":{"line":142,"column":1},"end":{"line":142,"co